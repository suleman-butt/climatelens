CLIMATELENS_ENV=local
CLIMATELENS_LOG_LEVEL=INFO
CLIMATELENS_GCP_PROJECT=
CLIMATELENS_GCP_REGION=europe-west3
CLIMATELENS_DATA_BUCKET=
CLIMATELENS_MODELS_BUCKET=
CLIMATELENS_DATA_DIR=./data
CLIMATELENS_MODEL_DIR=./models
# Bearer token for /jobs/* endpoints; leave empty to disable them.
CLIMATELENS_JOBS_TOKEN=
# Cloud Scheduler OIDC auth for /jobs/* (set by Terraform on Cloud Run).
CLIMATELENS_JOBS_OIDC_AUDIENCE=
CLIMATELENS_JOBS_OIDC_SERVICE_ACCOUNT=
